#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
int main()
{
    int fd;
    struct stat file_stat;
    DIR *dir;
    struct dirent *entry;
    fd = open("/tmp/sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0666);
    if (fd == -1)
    {
        perror("open");
        return 1;
    }
    printf("File opened successfully.\n");
    int flags = fcntl(fd, F_GETFL);
    if (flags == -1)
    {
        perror("fcntl");
        close(fd);
        return 1;
    }
    printf("fcntl() executed successfully.\n");
    write(fd, "Hello UNIX\n", 11);
    if (lseek(fd, 0, SEEK_END) == -1)
    {
        perror("lseek");
        close(fd);
        return 1;
    }
    printf("lseek() executed successfully.\n");
    if (stat("/tmp/sample.txt", &file_stat) == -1)
    {
        perror("stat");
        close(fd);
        return 1;
    }
    printf("stat() executed successfully.\n");
    printf("File size: %ld bytes\n", file_stat.st_size);
    printf("Inode number: %ld\n", file_stat.st_ino);
    close(fd);
    dir = opendir("/tmp");
    if (dir == NULL)
    {
        perror("opendir");
        return 1;
    }
    printf("\nFiles in /tmp directory:\n");
    while ((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }
    closedir(dir);
    return 0;
}
