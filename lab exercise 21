#include <stdio.h>
int main()
{
    int blocks[20], processes[20];
    int allocation[20];
    int nBlocks, nProcesses;
    int i, j, worstIndex;
    printf("Enter number of memory blocks: ");
    scanf("%d", &nBlocks);
    printf("Enter size of each memory block:\n");
    for (i = 0; i < nBlocks; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &blocks[i]);
    }
    printf("\nEnter number of processes: ");
    scanf("%d", &nProcesses);
    printf("Enter memory required by each process:\n");
    for (i = 0; i < nProcesses; i++)
    {
        printf("Process %d: ", i + 1);
        scanf("%d", &processes[i]);
        allocation[i] = -1;
    }
    for (i = 0; i < nProcesses; i++)
    {
        worstIndex = -1;
        for (j = 0; j < nBlocks; j++)
        {
            if (blocks[j] >= processes[i])
            {
                if (worstIndex == -1 ||
                    blocks[j] > blocks[worstIndex])
                {
                    worstIndex = j;
                }
            }
        }
        if (worstIndex != -1)
        {
            allocation[i] = worstIndex;
            blocks[worstIndex] -= processes[i];
        }
    }
    printf("\n--------------------------------------------------\n");
    printf("Process\tRequired\tAllocated Block\n");
    printf("--------------------------------------------------\n");
    for (i = 0; i < nProcesses; i++)
    {
        if (allocation[i] != -1)
            printf("P%d\t%d\t\tBlock %d\n",
                   i + 1, processes[i], allocation[i] + 1);
        else
            printf("P%d\t%d\t\tNot Allocated\n",
                   i + 1, processes[i]);
    }
    printf("--------------------------------------------------\n");
    printf("\nRemaining Memory in Blocks:\n");
    for (i = 0; i < nBlocks; i++)
    {
        printf("Block %d = %d KB\n", i + 1, blocks[i]);
    }
    return 0;
}
