#include <stdio.h>
struct Employee
{
    int id;
    char name[30];
    float salary;
};
int main()
{
    FILE *fp;
    struct Employee emp;
    int n, record;
    fp = fopen("employee.dat", "wb+");
    if (fp == NULL)
    {
        printf("File cannot be opened.\n");
        return 1;
    }
    printf("Enter number of employees: ");
    scanf("%d", &n);
    /* Store employee details */
    for (int i = 0; i < n; i++)
    {
        printf("\nEnter details of Employee %d\n", i + 1);
        printf("Enter ID: ");
        scanf("%d", &emp.id);
        printf("Enter Name: ");
        scanf("%29s", emp.name);
        printf("Enter Salary: ");
        scanf("%f", &emp.salary);
        fwrite(&emp, sizeof(struct Employee), 1, fp);
    }
    /* Random access */
    printf("\nEnter employee record number to access: ");
    scanf("%d", &record);
    if (record < 1 || record > n)
    {
        printf("Invalid record number.\n");
        fclose(fp);
        return 0;
    }
    fseek(fp, (record - 1) * sizeof(struct Employee), SEEK_SET);
    fread(&emp, sizeof(struct Employee), 1, fp);
    printf("\n--- Employee Details ---\n");
    printf("ID     : %d\n", emp.id);
    printf("Name   : %s\n", emp.name);
    printf("Salary : %.2f\n", emp.salary);
    fclose(fp);
    return 0;
}
