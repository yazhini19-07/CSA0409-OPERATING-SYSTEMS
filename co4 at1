#include <stdio.h>
#define MAX_BLOCKS 1000
int main()
{
    int disk[MAX_BLOCKS];
    int totalBlocks, fileSize, method;
    int i, j, start, count;
    int allocated[MAX_BLOCKS];
    printf("Enter total number of disk blocks: ");
    scanf("%d", &totalBlocks);
    if (totalBlocks <= 0 || totalBlocks > MAX_BLOCKS)
    {
        printf("Invalid disk size.\n");
        return 1;
    }
    for (i = 0; i < totalBlocks; i++)
        disk[i] = 0;
    printf("Enter file size (number of blocks): ");
    scanf("%d", &fileSize);
    if (fileSize <= 0 || fileSize > totalBlocks)
    {
        printf("Invalid file size.\n");
        return 1;
    }
    printf("\nFile Allocation Methods\n");
    printf("1. Contiguous Allocation\n");
    printf("2. Linked Allocation\n");
    printf("3. Indexed Allocation\n");
    printf("Enter allocation method: ");
    scanf("%d", &method);
    if (method < 1 || method > 3)
    {
        printf("Invalid allocation method.\n");
        return 1;
    }
    if (method == 1)
    {
        int found = 0;
        for (start = 0; start <= totalBlocks - fileSize; start++)
        {
            count = 0;
            for (j = start; j < start + fileSize; j++)
            {
                if (disk[j] == 0)
                    count++;
                else
                    break;
            }
            if (count == fileSize)
            {
                found = 1;
                for (j = start; j < start + fileSize; j++)
                    disk[j] = 1;
                printf("\nContiguous Allocation Successful.\n");
                printf("Allocated blocks: ");
                for (j = start; j < start + fileSize; j++)
                    printf("%d ", j);
                printf("\n");
                break;
            }
        }
        if (!found)
        {
            printf("\nContiguous Allocation Failed.\n");
            printf("Error: Insufficient continuous free space.\n");
            printf("Although enough total free blocks may exist, they are fragmented.\n");
        }
    }
    else if (method == 2)
    {
        count = 0;
        for (i = 0; i < totalBlocks && count < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                allocated[count] = i;
                disk[i] = 1;
                count++;
            }
        }
        if (count == fileSize)
        {
            printf("\nLinked Allocation Successful.\n");
            printf("Allocated blocks: ");
            for (i = 0; i < fileSize; i++)
                printf("%d ", allocated[i]);
            printf("\n");
            printf("Linked sequence: ");
            for (i = 0; i < fileSize; i++)
            {
                printf("%d", allocated[i]);
                if (i < fileSize - 1)
                    printf(" -> ");
            }
            printf(" -> NULL\n");
        }
        else
        {
            printf("\nLinked Allocation Failed.\n");
            printf("Error: Not enough free blocks on the disk.\n");
        }
    }
    else if (method == 3)
    {
        int indexBlock = -1;
        int dataCount = 0;
        for (i = 0; i < totalBlocks; i++)
        {
            if (disk[i] == 0)
            {
                indexBlock = i;
                disk[i] = 1;
                break;
            }
        }
        if (indexBlock == -1)
        {
            printf("\nIndexed Allocation Failed.\n");
            printf("Error: No free block available for index block.\n");
            return 0;
        }
        for (i = 0; i < totalBlocks && dataCount < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                allocated[dataCount] = i;
                disk[i] = 1;
                dataCount++;
            }
        }
        if (dataCount == fileSize)
        {
            printf("\nIndexed Allocation Successful.\n");
            printf("Index block: %d\n", indexBlock);
            printf("Data blocks: ");
            for (i = 0; i < fileSize; i++)
                printf("%d ", allocated[i]);
            printf("\n");
            printf("Index block %d contains pointers to the above data blocks.\n",
                   indexBlock);
        }
        else
        {
            disk[indexBlock] = 0;
            printf("\nIndexed Allocation Failed.\n");
            printf("Error: Not enough free blocks for the file.\n");
        }
    }
    return 0;
}
