#include <stdio.h>
#include <stdlib.h>
#define MAX 100
int main()
{
    int disk[MAX] = {0};
    int blocks, file, alloc, sched;
    int req[MAX], n, head;
    int allocated[MAX], count = 0;
    int i, j, cur, min, pos, total = 0;
    printf("Enter total disk blocks: ");
    scanf("%d", &blocks);
    printf("Enter file size: ");
    scanf("%d", &file);
    printf("Allocation (1=Contiguous, 2=Indexed): ");
    scanf("%d", &alloc);
    printf("Scheduling (1=FCFS, 2=SSTF): ");
    scanf("%d", &sched);
    printf("Enter number of disk requests: ");
    scanf("%d", &n);
    printf("Enter request queue: ");
    for (i = 0; i < n; i++)
        scanf("%d", &req[i]);
    printf("Enter initial head position: ");
    scanf("%d", &head);
    if (alloc == 1)
    {
        for (i = 0; i <= blocks - file; i++)
        {
            for (j = 0; j < file && disk[i + j] == 0; j++);
            if (j == file)
            {
                for (j = 0; j < file; j++)
                {
                    disk[i + j] = 1;
                    allocated[count++] = i + j;
                }
                break;
            }
        }
    }
    else             
    {
        for (i = 0; i < blocks && count < file + 1; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                allocated[count++] = i;
            }
        }
        if (count == file)
            count = 0;
    }
    if ((alloc == 1 && count != file) ||
        (alloc == 2 && count != file + 1))
    {
        printf("\nAllocation failed!\n");
        return 0;
    }
    printf("\nAllocated blocks: ");
    if (alloc == 2)
        printf("Index=%d, ", allocated[0]);
    for (i = (alloc == 2); i < count; i++)
        printf("%d ", allocated[i]);
    cur = head;
    printf("\n\nSeek sequence: %d", cur);
    if (sched == 1)    
    {
        for (i = 0; i < n; i++)
        {
            total += abs(cur - req[i]);
            cur = req[i];
            printf(" -> %d", cur);
        }
    }
    else              
    {
        int used[MAX] = {0};
        for (i = 0; i < n; i++)
        {
            min = 9999;
            pos = -1;
            for (j = 0; j < n; j++)
            {
                if (!used[j] && abs(cur - req[j]) < min)
                {
                    min = abs(cur - req[j]);
                    pos = j;
                }
            }
            used[pos] = 1;
            total += min;
            cur = req[pos];
            printf(" -> %d", cur);
        }
    }
    printf("\nTotal seek time = %d\n", total);
    printf("\nCombination: ");
    printf("%s + %s\n",
           alloc == 1 ? "Contiguous" : "Indexed",
           sched == 1 ? "FCFS" : "SSTF");
    printf("Performance: Lower seek time is better.\n");
    return 0;
}
