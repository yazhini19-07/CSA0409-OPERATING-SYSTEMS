#include <stdlib.h>
#define MAX 100
int main()
{
    int request[MAX], temp[MAX];
    int n, diskSize, head;
    int i, j, pos, min, index;
    int totalFCFS = 0, totalSSTF = 0, totalSCAN = 0;
    int current;
    printf("Enter disk size: ");
    scanf("%d", &diskSize);
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);
    printf("Enter initial head position: ");
    scanf("%d", &head);
    current = head;
    printf("\n--- FCFS ---\n");
    printf("Seek sequence: %d", current);
    for (i = 0; i < n; i++)
    {
        totalFCFS += abs(current - request[i]);
        current = request[i];
        printf(" -> %d", current);
    }

    printf("\nTotal seek time = %d\n", totalFCFS);
    for (i = 0; i < n; i++)
        temp[i] = request[i];
    current = head;
    printf("\n--- SSTF ---\n");
    printf("Seek sequence: %d", current);
    for (i = 0; i < n; i++)
    {
        min = 9999;
        index = -1;
        for (j = 0; j < n; j++)
        {
            if (temp[j] != -1)
            {
                if (abs(current - temp[j]) < min)
                {
                    min = abs(current - temp[j]);
                    index = j;
                }
            }
        }
        totalSSTF += min;
        current = temp[index];
        printf(" -> %d", current);
        temp[index] = -1;
    }
    printf("\nTotal seek time = %d\n", totalSSTF);
    for (i = 0; i < n; i++)
        temp[i] = request[i];
    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (temp[i] > temp[j])
            {
                int t = temp[i];
                temp[i] = temp[j];
                temp[j] = t;
            }
        }
    }

    printf("\n--- SCAN ---\n");
    printf("Seek sequence: %d", head);
    current = head;
    for (i = n - 1; i >= 0; i--)
    {
        if (temp[i] <= head)
        {
            totalSCAN += abs(current - temp[i]);
            current = temp[i];
            printf(" -> %d", current);
        }
    }
    if (current != 0)
    {
        totalSCAN += current;
        current = 0;
        printf(" -> %d", current);
    }
    for (i = 0; i < n; i++)
    {
        if (temp[i] > head)
        {
            totalSCAN += abs(current - temp[i]);
            current = temp[i];
            printf(" -> %d", current);
        }
    }
    printf("\nTotal seek time = %d\n", totalSCAN);
    printf("\n========== COMPARISON ==========\n");
    printf("FCFS  Total Seek Time = %d\n", totalFCFS);
    printf("SSTF  Total Seek Time = %d\n", totalSSTF);
    printf("SCAN  Total Seek Time = %d\n", totalSCAN);
    if (totalFCFS <= totalSSTF && totalFCFS <= totalSCAN)
        printf("\nBest Performing Algorithm: FCFS\n");
    else if (totalSSTF <= totalFCFS && totalSSTF <= totalSCAN)
        printf("\nBest Performing Algorithm: SSTF\n");
    else
        printf("\nBest Performing Algorithm: SCAN\n");
    return 0;
}
