#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
int main()
{
    int fd;
    char write_data[] = "Hello, UNIX File Management!";
    char read_data[100];
    int n;
    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if (fd == -1)
    {
        perror("Error opening file");
        return 1;
    }
    write(fd, write_data, sizeof(write_data) - 1);
    lseek(fd, 0, SEEK_SET);
    n = read(fd, read_data, sizeof(read_data) - 1);
    if (n >= 0)
        read_data[n] = '\0';
    printf("File content: %s\n", read_data);
    close(fd);
    return 0;
}
