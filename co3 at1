QUESTION 3:
#include <stdio.h>
int main()
{
    int pt[10], n, p, offset, size, frame, pa, i;
    printf("Enter number of pages: ");
    scanf("%d", &n);
    printf("Enter page size: ");
    scanf("%d", &size);
    for(i = 0; i < n; i++)
    {
        printf("Frame for Page %d: ", i);
        scanf("%d", &pt[i]);
    }
    printf("Enter Page Number: ");
    scanf("%d", &p);
    printf("Enter Offset: ");
    scanf("%d", &offset);
    if(p < n && offset < size)
    {
        frame = pt[p];
        pa = frame * size + offset;
        printf("Frame Number = %d\n", frame);
        printf("Physical Address = %d\n", pa);
    }
    else
    {
        printf("Invalid Address");
    }
    return 0;
}

