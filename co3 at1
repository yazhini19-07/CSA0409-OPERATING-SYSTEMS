QUESTION 4:
#include <stdio.h>
int main()
{
    float memoryTime, tlbTime, hitRatio;
    float withoutTLB, withTLB;
    printf("Enter Memory Access Time: ");
    scanf("%f", &memoryTime);
    printf("Enter TLB Access Time: ");
    scanf("%f", &tlbTime);
    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hitRatio);
    withoutTLB = 2 * memoryTime;
    withTLB = hitRatio * (tlbTime + memoryTime) +
              (1 - hitRatio) * (tlbTime + 2 * memoryTime);
    printf("\nMemory Access Time without TLB = %.2f\n", withoutTLB);
    printf("Effective Memory Access Time with TLB = %.2f\n", withTLB);
    return 0;
}

OUTPUT:
Enter Memory Access Time: 100
Enter TLB Access Time: 20
Enter TLB Hit Ratio (0 to 1): 0.8
Memory Access Time without TLB = 200.00
Effective Memory Access Time with TLB = 140.00

