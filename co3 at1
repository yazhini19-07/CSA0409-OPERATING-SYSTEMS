#include <stdio.h>
int main()
{
    int pageSize, pageTable[10];
    int pages, pageNo, offset, frameNo, physicalAddress, i;
    printf("Enter Page Size: ");
    scanf("%d", &pageSize);
    printf("Enter Number of Pages: ");
    scanf("%d", &pages);
    for(i = 0; i < pages; i++)
      {
        printf("Frame for Page %d: ", i);
        scanf("%d", &pageTable[i]);
    }
    printf("Enter Page Number: ");
    scanf("%d", &pageNo);
    printf("Enter Offset: ");
    scanf("%d", &offset);
    if(pageNo < pages && offset < pageSize)
    {
        frameNo = pageTable[pageNo];
        physicalAddress = frameNo * pageSize + offset;

        printf("Frame Number = %d\n", frameNo);
        printf("Physical Address = %d\n", physicalAddress);
    }
    else
    {
        printf("Invalid Address\n");
    }
    return 0;
}

