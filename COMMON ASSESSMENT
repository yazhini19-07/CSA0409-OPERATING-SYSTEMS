#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define N 5
#define R 16
#define QN 8

typedef struct {
    char id[3];
    int at, bt, pr;
    int ct, wt, tat, rem;
} Process;

void print_avg(Process p[])
{
    double aw = 0, at = 0;

    for (int i = 0; i < N; i++) {
        aw += p[i].wt;
        at += p[i].tat;
    }

    printf("Average Waiting Time    : %.2f\n", aw / N);
    printf("Average Turnaround Time : %.2f\n", at / N);
}

void fcfs(Process in[])
{
    Process p[N];

    for (int i = 0; i < N; i++)
        p[i] = in[i];

    int t = 0;

    printf("\nFCFS Gantt: ");

    for (int i = 0; i < N; i++) {

        if (t < p[i].at)
            t = p[i].at;

        t += p[i].bt;

        p[i].ct = t;
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt = p[i].tat - p[i].bt;

        printf("| %s ", p[i].id);
    }

    printf("|\n");

    print_avg(p);
}

void sjf(Process in[])
{
    Process p[N];

    for (int i = 0; i < N; i++)
        p[i] = in[i];

    int done[N] = {0};
    int count = 0, t = 0;

    printf("\nSJF Gantt: ");

    while (count < N) {

        int k = -1;

        for (int i = 0; i < N; i++) {

            if (!done[i] && p[i].at <= t &&
                (k == -1 || p[i].bt < p[k].bt)) {
                k = i;
            }
        }

        if (k == -1) {
            t++;
            continue;
        }

        t += p[k].bt;

        p[k].ct = t;
        p[k].tat = t - p[k].at;
        p[k].wt = p[k].tat - p[k].bt;

        done[k] = 1;
        count++;

        printf("| %s ", p[k].id);
    }

    printf("|\n");

    print_avg(p);
}

void priority_sched(Process in[])
{
    Process p[N];

    for (int i = 0; i < N; i++)
        p[i] = in[i];

    int done[N] = {0};
    int count = 0, t = 0;

    printf("\nPriority Gantt (5 = highest): ");

    while (count < N) {

        int k = -1;

        for (int i = 0; i < N; i++) {

            if (!done[i] && p[i].at <= t &&
                (k == -1 || p[i].pr > p[k].pr)) {
                k = i;
            }
        }

        if (k == -1) {
            t++;
            continue;
        }

        t += p[k].bt;

        p[k].ct = t;
        p[k].tat = t - p[k].at;
        p[k].wt = p[k].tat - p[k].bt;

        done[k] = 1;
        count++;

        printf("| %s ", p[k].id);
    }

    printf("|\n");

    print_avg(p);
}

void rr(Process in[], int quantum)
{
    Process p[N];

    for (int i = 0; i < N; i++) {
        p[i] = in[i];
        p[i].rem = p[i].bt;
    }

    int q[100];
    int front = 0, rear = 0;
    int added[N] = {0};
    int finished = 0, t = 0;

    printf("\nRound Robin Gantt (q = %d): ", quantum);

    while (finished < N) {

        for (int i = 0; i < N; i++) {
            if (!added[i] && p[i].at <= t) {
                q[rear++] = i;
                added[i] = 1;
            }
        }

        if (front == rear) {
            t++;
            continue;
        }

        int k = q[front++];

        int run = (p[k].rem < quantum) ? p[k].rem : quantum;

        printf("| %s ", p[k].id);

        t += run;
        p[k].rem -= run;

        for (int i = 0; i < N; i++) {
            if (!added[i] && p[i].at <= t) {
                q[rear++] = i;
                added[i] = 1;
            }
        }

        if (p[k].rem > 0) {
            q[rear++] = k;
        }
        else {
            p[k].ct = t;
            p[k].tat = t - p[k].at;
            p[k].wt = p[k].tat - p[k].bt;
            finished++;
        }
    }

    printf("|\n");

    print_avg(p);
}

int fifo(int ref[], int n, int frames)
{
    int f[10], pos = 0, faults = 0;

    for (int i = 0; i < frames; i++)
        f[i] = -1;

    for (int i = 0; i < n; i++) {

        int hit = 0;

        for (int j = 0; j < frames; j++) {
            if (f[j] == ref[i])
                hit = 1;
        }

        if (!hit) {
            f[pos] = ref[i];
            pos = (pos + 1) % frames;
            faults++;
        }
    }

    return faults;
}

int lru(int ref[], int n, int frames)
{
    int f[10], age[10] = {0}, faults = 0;

    for (int i = 0; i < frames; i++)
        f[i] = -1;

    for (int i = 0; i < n; i++) {

        int hit = -1;

        for (int j = 0; j < frames; j++) {
            if (f[j] == ref[i])
                hit = j;
        }

        if (hit != -1) {
            age[hit] = i + 1;
        }
        else {

            int k = 0;

            for (int j = 1; j < frames; j++) {
                if (age[j] < age[k])
                    k = j;
            }

            f[k] = ref[i];
            age[k] = i + 1;
            faults++;
        }
    }

    return faults;
}

int optimal(int ref[], int n, int frames)
{
    int f[10], faults = 0;

    for (int i = 0; i < frames; i++)
        f[i] = -1;

    for (int i = 0; i < n; i++) {

        int hit = 0;

        for (int j = 0; j < frames; j++) {
            if (f[j] == ref[i])
                hit = 1;
        }

        if (hit)
            continue;

        int k = -1, far = -1;

        for (int j = 0; j < frames; j++) {

            int next = n + 1;

            for (int x = i + 1; x < n; x++) {
                if (ref[x] == f[j]) {
                    next = x;
                    break;
                }
            }

            if (next > far) {
                far = next;
                k = j;
            }
        }

        f[k] = ref[i];
        faults++;
    }

    return faults;
}

int seek(int a[], int n, int start)
{
    int total = 0, cur = start;

    for (int i = 0; i < n; i++) {
        total += abs(cur - a[i]);
        cur = a[i];
    }

    return total;
}

int sstf(int a[], int n, int start)
{
    int used[QN] = {0};
    int total = 0, cur = start;

    for (int c = 0; c < n; c++) {

        int k = -1;
        int best = INT_MAX;

        for (int i = 0; i < n; i++) {

            if (!used[i] &&
                abs(cur - a[i]) < best) {

                best = abs(cur - a[i]);
                k = i;
            }
        }

        used[k] = 1;

        total += abs(cur - a[k]);
        cur = a[k];
    }

    return total;
}

int scan_up(int a[], int n, int start, int maxc)
{
    int b[QN], m = 0;
    int total = 0, cur = start;

    for (int i = 0; i < n; i++) {
        if (a[i] >= start)
            b[m++] = a[i];
    }

    for (int i = 0; i < m; i++) {
        for (int j = i + 1; j < m; j++) {

            if (b[i] > b[j]) {
                int x = b[i];
                b[i] = b[j];
                b[j] = x;
            }
        }
    }

    for (int i = 0; i < m; i++) {
        total += abs(cur - b[i]);
        cur = b[i];
    }

    total += abs(cur - maxc);
    cur = maxc;

    m = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] < start)
            b[m++] = a[i];
    }

    for (int i = 0; i < m; i++) {
        for (int j = i + 1; j < m; j++) {

            if (b[i] < b[j]) {
                int x = b[i];
                b[i] = b[j];
                b[j] = x;
            }
        }
    }

    for (int i = 0; i < m; i++) {
        total += abs(cur - b[i]);
        cur = b[i];
    }

    return total;
}

int cscan_up(int a[], int n, int start, int maxc)
{
    int b[QN], m = 0;
    int total = 0, cur = start;

    for (int i = 0; i < n; i++) {
        if (a[i] >= start)
            b[m++] = a[i];
    }

    for (int i = 0; i < m; i++) {
        for (int j = i + 1; j < m; j++) {

            if (b[i] > b[j]) {
                int x = b[i];
                b[i] = b[j];
                b[j] = x;
            }
        }
    }

    for (int i = 0; i < m; i++) {
        total += abs(cur - b[i]);
        cur = b[i];
    }

    total += abs(cur - maxc);
    cur = maxc;

    total += maxc;
    cur = 0;

    m = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] < start)
            b[m++] = a[i];
    }

    for (int i = 0; i < m; i++) {
        for (int j = i + 1; j < m; j++) {

            if (b[i] > b[j]) {
                int x = b[i];
                b[i] = b[j];
                b[j] = x;
            }
        }
    }

    for (int i = 0; i < m; i++) {
        total += abs(cur - b[i]);
        cur = b[i];
    }

    return total;
}

int main(void)
{
    Process p[N] = {
        {"P1", 0, 3, 2},
        {"P2", 1, 7, 5},
        {"P3", 2, 4, 3},
        {"P4", 4, 5, 4},
        {"P5", 6, 2, 1}
    };

    int ref[R] = {
        1, 6, 2, 6, 1, 4, 4, 6,
        1, 3, 6, 4, 1, 2, 3, 4
    };

    int disk[QN] = {
        10, 90, 40, 100,
        65, 25, 80, 105
    };

    printf("ATM / SELF-SERVICE TRANSACTION QUEUE - OS SIMULATION\n");
    printf("------------------------------------------------------\n");

    fcfs(p);
    sjf(p);
    priority_sched(p);
    rr(p, 2);

    printf("\nMemory (3 frames, 16 references)\n");
    printf("--------------------------------\n");

    printf("FIFO faults    : %d\n", fifo(ref, R, 3));
    printf("LRU faults     : %d\n", lru(ref, R, 3));
    printf("Optimal faults : %d\n", optimal(ref, R, 3));

    printf("\nDisk (0-110, head = 55)\n");
    printf("------------------------\n");

    printf("FCFS head movement  : %d\n", seek(disk, QN, 55));
    printf("SSTF head movement  : %d\n", sstf(disk, QN, 55));
    printf("SCAN head movement  : %d\n", scan_up(disk, QN, 55, 110));
    printf("C-SCAN head movement: %d\n",
           cscan_up(disk, QN, 55, 110));

    return 0;
}
