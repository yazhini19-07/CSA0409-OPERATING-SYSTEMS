#include <stdio.h>

int main()
{
    int n, i, tq;
    int bt[20], rt[20], wt[20], tat[20];
    int time = 0, remain;
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    remain = n;

    printf("\nEnter Burst Time:\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d: ", i + 1);
        scanf("%d", &bt[i]);
        rt[i] = bt[i];
    }

    printf("\nEnter Time Quantum: ");
    scanf("%d", &tq);

    while(remain != 0)
    {
        for(i = 0; i < n; i++)
        {
            if(rt[i] > 0)
            {
                if(rt[i] > tq)
                {
                    time += tq;
                    rt[i] -= tq;
                }
                else
                {
                    time += rt[i];
                    wt[i] = time - bt[i];
                    rt[i] = 0;
                    remain--;
                    tat[i] = wt[i] + bt[i];
                }
            }
        }
    }

    printf("\n---------------------------------------------------------");
    printf("\nProcess\tBurst Time\tWaiting Time\tTurnaround Time");
    printf("\n---------------------------------------------------------");

    for(i = 0; i < n; i++)
    {
        avg_wt += wt[i];
        avg_tat += tat[i];

        printf("\nP%d\t%d\t\t%d\t\t%d",
               i + 1, bt[i], wt[i], tat[i]);
    }

    printf("\n---------------------------------------------------------");
    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f", avg_tat / n);

    return 0;
}
