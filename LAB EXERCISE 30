#include <stdio.h>
#include <pthread.h>
void *display(void *arg)
{
    printf("Child thread is running.\n");
    return NULL;
}
int main()
{
    pthread_t thread;
    pthread_create(&thread, NULL, display, NULL);
    printf("Main thread is running.\n");
    pthread_join(thread, NULL);
    return 0;
}
