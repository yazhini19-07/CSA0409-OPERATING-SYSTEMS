#include <stdio.h>
#include <stdlib.h>
int main()
{
    int a[20], n, head, size, i, j, temp, total=0;
    printf("Number of requests: ");
    scanf("%d",&n);
    printf("Requests: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Initial head: ");
    scanf("%d",&head);
    printf("Disk size: ");
    scanf("%d",&size);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
            {
                temp=a[i]; a[i]=a[j]; a[j]=temp;
            }
    for(i=0;i<n;i++)
        if(a[i]>=head) break;
    for(j=i;j<n;j++)
    {
        total += abs(head-a[j]);
        head=a[j];
    }
    total += (size-1)-head;
    head=0;
    total += size-1;
    for(j=0;j<i;j++)
    {
        total += abs(head-a[j]);
        head=a[j];
    }
    printf("Total Seek Time = %d",total);
    return 0;
}
