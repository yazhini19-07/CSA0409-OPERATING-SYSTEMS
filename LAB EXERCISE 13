#include <stdio.h>
void firstFit(int blocks[], int b, int processes[], int p)
{
    int allocation[20];
    int temp[20];
    for (int i = 0; i < b; i++)
        temp[i] = blocks[i];
    for (int i = 0; i < p; i++)
        allocation[i] = -1;
    for (int i = 0; i < p; i++)
    {
        for (int j = 0; j < b; j++)
        {
            if (temp[j] >= processes[i])
            {
                allocation[i] = j;
                temp[j] -= processes[i];
                break;
            }
        }
    }
    printf("\n--- First Fit ---\n");
    for (int i = 0; i < p; i++)
    {
        if (allocation[i] != -1)
            printf("Process %d (%d KB) -> Block %d\n",
                   i + 1, processes[i], allocation[i] + 1);
        else
            printf("Process %d (%d KB) -> Not Allocated\n",
                   i + 1, processes[i]);
    }
}
void bestFit(int blocks[], int b, int processes[], int p)
{
    int allocation[20];
    int temp[20];
    for (int i = 0; i < b; i++)
        temp[i] = blocks[i];
    for (int i = 0; i < p; i++)
        allocation[i] = -1;
    for (int i = 0; i < p; i++)
    {
        int best = -1;
        for (int j = 0; j < b; j++)
        {
            if (temp[j] >= processes[i])
            {
                if (best == -1 || temp[j] < temp[best])
                    best = j;
            }
        }
        if (best != -1)
        {
            allocation[i] = best;
            temp[best] -= processes[i];
        }
    }
    printf("\n--- Best Fit ---\n");
    for (int i = 0; i < p; i++)
    {
        if (allocation[i] != -1)
            printf("Process %d (%d KB) -> Block %d\n",
                   i + 1, processes[i], allocation[i] + 1);
        else
            printf("Process %d (%d KB) -> Not Allocated\n",
                   i + 1, processes[i]);
    }
}
void worstFit(int blocks[], int b, int processes[], int p)
{
    int allocation[20];
    int temp[20];
    for (int i = 0; i < b; i++)
        temp[i] = blocks[i];
    for (int i = 0; i < p; i++)
        allocation[i] = -1;
    for (int i = 0; i < p; i++)
    {
        int worst = -1;
        for (int j = 0; j < b; j++)
        {
            if (temp[j] >= processes[i])
            {
                if (worst == -1 || temp[j] > temp[worst])
                    worst = j;
            }
        }
        if (worst != -1)
        {
            allocation[i] = worst;
            temp[worst] -= processes[i];
        }
    }
    printf("\n--- Worst Fit ---\n");
    for (int i = 0; i < p; i++)
    {
        if (allocation[i] != -1)
            printf("Process %d (%d KB) -> Block %d\n",
                   i + 1, processes[i], allocation[i] + 1);
        else
            printf("Process %d (%d KB) -> Not Allocated\n",
                   i + 1, processes[i]);
    }
}
int main()
{
    int blocks[20], processes[20];
    int b, p;
    printf("Enter number of memory blocks: ");
    scanf("%d", &b);
    printf("Enter size of each memory block:\n");
    for (int i = 0; i < b; i++)
        scanf("%d", &blocks[i]);
    printf("Enter number of processes: ");
    scanf("%d", &p);
    printf("Enter memory required by each process:\n");
    for (int i = 0; i < p; i++)
        scanf("%d", &processes[i]);
    firstFit(blocks, b, processes, p);
    bestFit(blocks, b, processes, p);
    worstFit(blocks, b, processes, p);
    return 0;
}
