#include <stdio.h>

int main()
{
    int n, i, time = 0, completed = 0;
    int at[20], bt[20], rt[20], pr[20];
    int wt[20], tat[20];
    int highest, minPriority;

    float avgWT = 0, avgTAT = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("\nEnter Arrival Time, Burst Time and Priority\n");

    for(i = 0; i < n; i++)
    {
        printf("\nProcess P%d\n", i + 1);

        printf("Arrival Time : ");
        scanf("%d", &at[i]);

        printf("Burst Time   : ");
        scanf("%d", &bt[i]);

        printf("Priority     : ");
        scanf("%d", &pr[i]);

        rt[i] = bt[i];
    }

    while(completed != n)
    {
        highest = -1;
        minPriority = 9999;

        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && rt[i] > 0)
            {
                if(pr[i] < minPriority)
                {
                    minPriority = pr[i];
                    highest = i;
                }
            }
        }

        if(highest == -1)
        {
            time++;
            continue;
        }

        rt[highest]--;
        time++;

        if(rt[highest] == 0)
        {
            completed++;

            tat[highest] = time - at[highest];
            wt[highest] = tat[highest] - bt[highest];

            avgWT += wt[highest];
            avgTAT += tat[highest];
        }
    }

    printf("\n---------------------------------------------------------------");
    printf("\nProcess\tAT\tBT\tPriority\tWT\tTAT");
    printf("\n---------------------------------------------------------------");

    for(i = 0; i < n; i++)
    {
        printf("\nP%d\t%d\t%d\t%d\t\t%d\t%d",
               i + 1, at[i], bt[i], pr[i], wt[i], tat[i]);
    }

    printf("\n---------------------------------------------------------------");

    printf("\nAverage Waiting Time = %.2f", avgWT / n);
    printf("\nAverage Turnaround Time = %.2f", avgTAT / n);

    return 0;
}
