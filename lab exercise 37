#include <stdio.h>
#include <stdlib.h>
int main()
{
    int a[20],n,head,i,total=0;
    printf("Number of requests: ");
    scanf("%d",&n);
    printf("Requests: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Initial head: ");
    scanf("%d",&head);
    for(i=0;i<n;i++)
    {
        total += abs(head-a[i]);
        head=a[i];
    }
    printf("Total Seek Time = %d",total);
    return 0;
}
