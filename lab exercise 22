#include <stdio.h>
int main()
{
    int block[20], process[20], allocation[20];
    int n, m, i, j, best;
    printf("Enter number of memory blocks: ");
    scanf("%d", &n);
    printf("Enter size of each memory block:\n");
    for (i = 0; i < n; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &block[i]);
    }
    printf("Enter number of processes: ");
    scanf("%d", &m);
    printf("Enter memory required by each process:\n");
    for (i = 0; i < m; i++)
    {
        printf("Process %d: ", i + 1);
        scanf("%d", &process[i]);
        allocation[i] = -1;
    }
    for (i = 0; i < m; i++)
    {
        best = -1;
        for (j = 0; j < n; j++)
        {
            if (block[j] >= process[i])
            {
                if (best == -1 || block[j] < block[best])
                    best = j;
            }
        }
        if (best != -1)
        {
            allocation[i] = best;
            block[best] -= process[i];
        }
    }
    printf("\n---------------------------------------------\n");
    printf("Process\tRequired\tAllocated Block\n");
    printf("---------------------------------------------\n");
    for (i = 0; i < m; i++)
    {
        if (allocation[i] != -1)
            printf("P%d\t%d KB\t\tBlock %d\n",
                   i + 1, process[i], allocation[i] + 1);
        else
            printf("P%d\t%d KB\t\tNot Allocated\n",
                   i + 1, process[i]);
    }
    printf("---------------------------------------------\n");
    printf("\nRemaining Memory:\n");
    for (i = 0; i < n; i++)
        printf("Block %d = %d KB\n", i + 1, block[i]);
    return 0;
}
