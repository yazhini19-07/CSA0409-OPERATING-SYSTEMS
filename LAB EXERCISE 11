#include <stdio.h>
#include <windows.h>

DWORD WINAPI ThreadFunction(LPVOID lpParam)
{
    int i;

    for(i = 1; i <= 5; i++)
    {
        printf("Thread is running: %d\n", i);
        Sleep(500);
    }

    return 0;
}

int main()
{
    HANDLE hThread;
    DWORD threadId;

    hThread = CreateThread(
        NULL,
        0,
        ThreadFunction,
        NULL,
        0,
        &threadId);

    if(hThread == NULL)
    {
        printf("Thread creation failed.\n");
        return 1;
    }

    WaitForSingleObject(hThread, INFINITE);

    printf("Thread execution completed.\n");

    CloseHandle(hThread);

    return 0;
}
