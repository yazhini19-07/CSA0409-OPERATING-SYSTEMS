#include <stdio.h>
#include <string.h>
int main()
{
    FILE *fp;
    char line[200];
    char search[50] = "UNIX";
    int line_no = 1;
    int found = 0;
    fp = fopen("sample.txt", "w");
    if (fp == NULL)
    {
        printf("Error creating file.\n");
        return 1;
    }
    fprintf(fp, "Hello World\n");
    fprintf(fp, "Operating System\n");
    fprintf(fp, "UNIX operating system\n");
    fprintf(fp, "C Programming\n");
    fprintf(fp, "UNIX Commands\n");
    fclose(fp);
    fp = fopen("sample.txt", "r");
    if (fp == NULL)
    {
        printf("Error opening file.\n");
        return 1;
    }
    printf("GREP Simulation\n");
    printf("Search word: %s\n\n", search);
    while (fgets(line, sizeof(line), fp) != NULL)
    {
        if (strstr(line, search) != NULL)
        {
            printf("Line %d: %s", line_no, line);
            found = 1;
        }
        line_no++;
    }
    if (found == 0)
    {
        printf("Pattern not found.\n");
    }
    fclose(fp);
    return 0;
}
